# ============================================
# PROJECT MANAGEMENT (DYNAMIC PROJECT LOADING)
# ============================================
#
# Use ACTIVE_PROJECT to dynamically load different project configurations
# This allows running multiple projects with different databases, API endpoints, etc.
#
# How it works:
# 1. Set ACTIVE_PROJECT=project1 to load .env.project1 configuration
# 2. Or pass project name as command argument: npm start project1
# 3. Project-specific .env files are .env.{projectName}
# 4. Default fallback is .env if project file not found
#
# Available projects: project1, project2
# See .env.project1 and .env.project2 for examples
#
# ACTIVE_PROJECT=project1  # Uncomment and set to load specific project
AVAILABLE_PROJECTS=project1,project2

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL Host (usually 'localhost' for local development)
DB_HOST=localhost

# PostgreSQL Port (default is 5432)
DB_PORT=5432

# Database Name (the database you created for this project)
DB_NAME=playwright_crx

# PostgreSQL Username (default superuser is 'postgres')
DB_USER=postgres

# PostgreSQL Password (set during PostgreSQL installation)
DB_PASSWORD=your_postgres_password_here

# Database Schema (usually 'public')
DB_SCHEMA=public

# Full Database Connection URL
# This is auto-generated from the above parameters
# You can also set this manually if you prefer:
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}"

# Database Pool Configuration
# Maximum clients in the pool (reduce for test environments)
DB_MAX_CLIENTS=10
DB_MIN_CLIENTS=2
# Idle timeout before releasing idle clients (ms)
DB_IDLE_TIMEOUT=30000
# Query timeout (ms)
DB_QUERY_TIMEOUT=30000
# Connection acquire timeout (ms)
DB_CONNECTION_TIMEOUT=5000

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET="your-super-secret-access-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"

# Server Configuration
PORT=3001
NODE_ENV=development

# AI Analysis Service (Python FastAPI)
AI_ANALYSIS_SERVICE_URL=http://localhost:8000

# CORS - Chrome Extension ID (update after extension installation)
ALLOWED_ORIGINS="chrome-extension://your-extension-id-here,http://localhost:3001"

# File Upload
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR="./uploads"

# WebSocket
WS_PORT=3001

# Logging
LOG_LEVEL=debug  # debug, info, warn, error

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_TIMEOUT_MINUTES=15  # Access token expiry
REFRESH_TOKEN_DAYS=7        # Refresh token expiry

# ============================================
# EXTERNAL API CONFIGURATION (Genie API)
# ============================================

# External LLM-Integrated Test Data Generation APIs
# These endpoints are used by the AI Analysis Service to generate test data

# Boundary Value Analysis - External Genie API
EXTERNAL_BOUNDARY_API_URL=http://34.46.36.105:3000/genieapi/assistant/testdata/boundary/generate

# Positive Test Data - External Genie API
EXTERNAL_POSITIVE_API_URL=http://34.46.36.105:3000/genieapi/assistant/testdata/positive/generate

# Negative Test Data - External Genie API
EXTERNAL_NEGATIVE_API_URL=http://34.46.36.105:3000/genieapi/assistant/testdata/negative/generate

# Security Test Data - External Genie API
EXTERNAL_SECURITY_API_URL=http://34.46.36.105:3000/genieapi/assistant/testdata/security/generate

# Equivalence Test Data - External Genie API
EXTERNAL_EQUIVALENCE_API_URL=http://34.46.36.105:3000/genieapi/assistant/testdata/equivalence/generate

# XPath Analysis - External Genie API
EXTERNAL_XPATH_DEEP_ANALYSIS_URL=http://34.46.36.105:3000/genieapi/ai-analysis/xpath-deep-analysis

# Upload Script XPath Analysis - External Genie API
EXTERNAL_UPLOAD_SCRIPT_XPATH_URL=http://34.46.36.105:3000/genieapi/ai-analysis/upload-script-xpath-analysis

# External API Access Token
# Bearer token for authentication with external Genie API
EXTERNAL_API_TOKEN=your_external_api_token_here

# ============================================
# REDIS CONFIGURATION (Job Queue)
# ============================================

# Redis server host
REDIS_HOST=localhost

# Redis server port
REDIS_PORT=6379

# Redis password (leave empty if no authentication)
REDIS_PASSWORD=

# Redis database number (0-15)
REDIS_DB=0

# ============================================
# JOB QUEUE CONFIGURATION
# ============================================

# Enable Redis-based job queue for test execution
# Set to 'true' to enable distributed test execution
ENABLE_QUEUE=false

# ============================================
# WORKER POOL CONFIGURATION
# ============================================

# Enable worker pool for parallel test execution
# Set to 'true' to start processing jobs
ENABLE_WORKER_POOL=false

# Number of worker processes in the pool
WORKER_POOL_SIZE=3

# Maximum concurrent jobs per worker
WORKER_CONCURRENCY=5

# Worker heartbeat interval in milliseconds
WORKER_HEARTBEAT_INTERVAL=30000
