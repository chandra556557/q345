# ============================================
# PROJECT 2 ENVIRONMENT CONFIGURATION
# ============================================

# Project Identifier
ACTIVE_PROJECT=project2
PROJECT_DISPLAY_NAME=Project 2 - Staging

# ============================================
# DATABASE CONFIGURATION
# ============================================

DB_HOST=localhost
DB_PORT=5434
DB_NAME=playwright_project2
DB_USER=postgres
DB_PASSWORD=postgres124112
DB_SCHEMA=public
DATABASE_URL="postgresql://postgres:postgres124112@localhost:5434/playwright_project2?schema=public"

# Database Pool Configuration
DB_MAX_CLIENTS=15
DB_MIN_CLIENTS=3
DB_IDLE_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ============================================
# SERVER CONFIGURATION
# ============================================

PORT=3002
NODE_ENV=staging

# JWT Secrets
JWT_ACCESS_SECRET="project2-access-secret-change-this"
JWT_REFRESH_SECRET="project2-refresh-secret-change-this"

# ============================================
# CORS & ORIGINS
# ============================================

ALLOWED_ORIGINS="chrome-extension://your-extension-id-here,http://localhost:3002,http://staging.example.com"

# ============================================
# EXTERNAL API CONFIGURATION
# ============================================

AI_ANALYSIS_SERVICE_URL=http://staging-ai:8000

EXTERNAL_BOUNDARY_API_URL=http://staging-genie:3000/genieapi/assistant/testdata/boundary/generate
EXTERNAL_POSITIVE_API_URL=http://staging-genie:3000/genieapi/assistant/testdata/positive/generate
EXTERNAL_NEGATIVE_API_URL=http://staging-genie:3000/genieapi/assistant/testdata/negative/generate
EXTERNAL_SECURITY_API_URL=http://staging-genie:3000/genieapi/assistant/testdata/security/generate
EXTERNAL_EQUIVALENCE_API_URL=http://staging-genie:3000/genieapi/assistant/testdata/equivalence/generate
EXTERNAL_XPATH_DEEP_ANALYSIS_URL=http://staging-genie:3000/genieapi/ai-analysis/xpath-deep-analysis
EXTERNAL_UPLOAD_SCRIPT_XPATH_URL=http://staging-genie:3000/genieapi/ai-analysis/upload-script-xpath-analysis
EXTERNAL_API_TOKEN=staging_token_here

# ============================================
# REDIS CONFIGURATION
# ============================================

REDIS_HOST=staging-redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_staging
REDIS_DB=1

# ============================================
# FEATURE FLAGS
# ============================================

ENABLE_QUEUE=true
ENABLE_WORKER_POOL=true
WORKER_POOL_SIZE=5
WORKER_CONCURRENCY=10
WORKER_HEARTBEAT_INTERVAL=30000

# ============================================
# LOGGING & RATE LIMITING
# ============================================

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500

# ============================================
# FILE UPLOAD
# ============================================

MAX_FILE_SIZE=52428800
UPLOAD_DIR="./uploads/project2"

# ============================================
# SESSION
# ============================================

SESSION_TIMEOUT_MINUTES=30
REFRESH_TOKEN_DAYS=14
