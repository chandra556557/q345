# Single Server Configuration
# All projects run on the same server (port 3001)
# Database connections routed based on X-Project header or ?project= query param

# ============ Server Configuration ============
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001

# ============ Project List ============
ACTIVE_PROJECT=project1
PROJECTS=project1,project2,project3

# ============ Project 1 Configuration ============
PROJECT1_DB_HOST=localhost
PROJECT1_DB_PORT=5433
PROJECT1_DB_NAME=playwright_project1
PROJECT1_DB_USER=postgres
PROJECT1_DB_PASSWORD=postgres
PROJECT1_API_URL=http://localhost:3001

# ============ Project 2 Configuration ============
PROJECT2_DB_HOST=localhost
PROJECT2_DB_PORT=5434
PROJECT2_DB_NAME=playwright_project2
PROJECT2_DB_USER=postgres
PROJECT2_DB_PASSWORD=postgres
PROJECT2_API_URL=http://localhost:3001

# ============ Project 3 Configuration ============
PROJECT3_DB_HOST=localhost
PROJECT3_DB_PORT=5435
PROJECT3_DB_NAME=playwright_project3
PROJECT3_DB_USER=postgres
PROJECT3_DB_PASSWORD=postgres
PROJECT3_API_URL=http://localhost:3001

# ============ Redis ============
REDIS_HOST=localhost
REDIS_PORT=6379

# ============ JWT ============
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# ============ Logging ============
LOG_LEVEL=info

# ============ Testing ============
CUCUMBER_TAGS=
TEST_TIMEOUT=60000
